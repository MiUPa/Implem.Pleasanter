# Kumitate 全部入り Docker の任意設定。
# このファイルを .env にコピーして編集すると有効になります。
# .env が無くても、下記の既定値のままで起動します（設定不要）。

# ブラウザで開くポート
KUMITATE_PORT=8080

# 使う Kumitate イメージのタグ（通常は latest のままで OK）
KUMITATE_VERSION=latest

# PostgreSQL の管理ユーザーとパスワード、システム用データベース名
# 注意: パスワード類は「初回起動の前」に変更してください。
#       起動後に .env だけ変更しても、作成済みの DB 側パスワードとは
#       一致しなくなり、接続できなくなります。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kumitate
POSTGRES_DB=postgres

# Kumitate が DB 内に作る専用ユーザーのパスワード
KUMITATE_OWNER_PASSWORD=kumitate_owner_pw
KUMITATE_USER_PASSWORD=kumitate_user_pw
